{
  "name": "motif",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Motif \u6bcd\u9898 \u2014 open-source market of UI components, motion effects, shaders and agent skills",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @motif/web dev",
    "dev:preview": "pnpm --filter @motif/preview dev",
    "dev:chain": "node scripts/dev-chain.mjs",
    "build": "pnpm --filter @motif/preview build && pnpm --filter @motif/web build",
    "lint": "pnpm lint:types && pnpm lint:eslint",
    "lint:types": "pnpm -r --workspace-concurrency=1 lint && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "lint:eslint": "eslint . --max-warnings=0",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "verify": "pnpm lint && pnpm test && pnpm build",
    "sources:sync": "node scripts/sources-sync.mjs",
    "capture": "tsx scripts/capture.ts",
    "audit:items": "pnpm --filter @motif/registry check",
    "items:sync-defaults": "pnpm --filter @motif/registry sync-defaults",
    "item:pack": "pnpm --filter @motif/registry run item:pack",
    "item:unpack": "pnpm --filter @motif/registry run item:unpack",
    "item:remix": "pnpm --filter @motif/registry run item:remix",
    "check:export": "tsx scripts/check-export.ts",
    "skills:build": "pnpm --filter @motif/skills build",
    "notices": "pnpm --filter @motif/registry notices"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@motif/export": "workspace:*",
    "@motif/preview": "workspace:*",
    "@motif/registry": "workspace:*",
    "@motif/schema": "workspace:*",
    "@motif/vendor": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.12.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
