{
  "name": "motif",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Motif 母题 — open-source market of UI components, motion effects, shaders and agent skills",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @motif/web dev",
    "dev:preview": "pnpm --filter @motif/preview dev",
    "build": "pnpm --filter @motif/preview build && pnpm --filter @motif/web build",
    "lint": "pnpm lint:types && pnpm lint:eslint",
    "lint:types": "pnpm -r --workspace-concurrency=1 lint && tsc --noEmit -p e2e/tsconfig.json",
    "lint:eslint": "eslint . --max-warnings=0",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "verify": "pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
