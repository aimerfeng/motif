# 站点的环境变量。开发时都可以不设：社区功能在跑过 `pnpm dev:chain` 后自动连本地链。

# 站点的公开地址（社交卡片、多语言链接用）
# MOTIF_SITE_URL=https://motif.example

# 预览沙箱的地址（必须和站点不同站点，见 docs/decisions/0001）
# NEXT_PUBLIC_MOTIF_PREVIEW_URL=http://127.0.0.1:4100

# 社区链（见 docs/deploy-community.md）。不设 MOTIF_CHAIN_RPC_URL 就关闭社区功能。
# MOTIF_CHAIN_RPC_URL=http://127.0.0.1:8545
# MOTIF_CHAIN_PUBLIC_RPC_URL=
# MOTIF_CHAIN_DEPLOYMENT=
# MOTIF_CHAIN_START_BLOCK=0
# MOTIF_CHAIN_NAME=
# 投稿源码和托管文字的存放目录（生产环境要放在持久化磁盘上）
# MOTIF_COMMUNITY_DATA=
