# 站点的环境变量。开发时都可以不设：社区功能在跑过 `pnpm dev:chain` 后自动连本地链。

# 站点的公开地址（社交卡片、多语言链接用）
# MOTIF_SITE_URL=https://motif.example

# 预览沙箱的地址（必须和站点不同站点，见 docs/decisions/0001）
# NEXT_PUBLIC_MOTIF_PREVIEW_URL=http://127.0.0.1:4100

# 社区链（见 docs/deploy-community.md）。不设 MOTIF_CHAIN_RPC_URL 就关闭社区功能。
# MOTIF_CHAIN_RPC_URL=http://127.0.0.1:8545
# MOTIF_CHAIN_PUBLIC_RPC_URL=
# MOTIF_CHAIN_DEPLOYMENT=
# MOTIF_CHAIN_START_BLOCK=0
# MOTIF_CHAIN_NAME=
# 投稿源码和托管文字的存放目录（生产环境要放在持久化磁盘上）
# MOTIF_COMMUNITY_DATA=

# 工作台（Studio）的 agent。开发模式不设时默认用本机 Claude Code CLI（claude-sonnet-5-5，只在开发期用，见 docs/decisions/0003）。
# MOTIF_AGENT_PROVIDER=claude-cli        # claude-cli | anthropic | openai-compatible | scripted（e2e 用）
# MOTIF_AGENT_API_KEY=                   # anthropic / openai-compatible 的 key，只放服务端
# MOTIF_AGENT_MODEL=                     # 例如 claude-sonnet-5-5
# MOTIF_AGENT_BASE_URL=                  # openai-compatible 必填；anthropic 可选（网关）
# MOTIF_AGENT_SESSION_TOKENS=600000      # 每个会话的模型用量上限
# MOTIF_CLAUDE_CLI_PATH=                 # 默认 ~/.local/bin/claude(.exe)
# MOTIF_CLAUDE_MODEL=claude-sonnet-5-5
# agent 截图（look_at_preview）用的浏览器：msedge | chrome | chromium | off。开发模式默认用本机 Edge / Chrome，生产默认关闭
# MOTIF_CAPTURE_CHANNEL=
# 工作台会话的存放目录（默认仓库根目录下的 .data/studio）
# MOTIF_STUDIO_DATA=
