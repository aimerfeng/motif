# 站点的环境变量。开发时都可以不设：社区功能在跑过 `pnpm dev:chain` 后自动连本地链。

# 站点的公开地址（社交卡片、多语言链接用）。生产环境必须设置：安装命令、交付物和 llms.txt 里的地址都用它，不信任请求里的 Host 头
# MOTIF_SITE_URL=https://motif.example

# 站点前面有几层自己的反向代理（nginx、Caddy 等，一层就是 1）。限流按代理看到的客户端地址计数；
# 不设置时拿不到可信的地址，所有请求共用一份限流额度
# MOTIF_TRUSTED_PROXY_HOPS=1

# 预览沙箱的地址（必须和站点不同站点，见 docs/decisions/0001）
# NEXT_PUBLIC_MOTIF_PREVIEW_URL=http://127.0.0.1:4100

# 账号、积分、用户仓库（docs/decisions/0009-accounts-credits-repos.md）。开发时都可以不设：
# 数据库默认在仓库根目录的 .data/motif.sqlite；没配 SMTP 时验证邮件、重置密码的链接打印在终端里。
# MOTIF_DB_PATH=
# MOTIF_AUTH_SECRET=                     # 生产环境必填，32 位以上随机字符串（openssl rand -base64 48）
# MOTIF_ADMIN_EMAILS=                    # 管理员邮箱，逗号分隔（验证过的才算）
# MOTIF_SUPPORT_EMAIL=                   # 付款通道接入前，用户把订单号发到这里
# MOTIF_GITHUB_CLIENT_ID=                # GitHub OAuth App，回调 <站点>/api/auth/callback/github
# MOTIF_GITHUB_CLIENT_SECRET=
# MOTIF_GITHUB_TOKEN=                    # 可选：匿名导入公开仓库时用的令牌（提高 GitHub 限额）
# MOTIF_SMTP_HOST=                       # Spacemail：mail.spacemail.com
# MOTIF_SMTP_PORT=465
# MOTIF_SMTP_USER=
# MOTIF_SMTP_PASSWORD=
# MOTIF_MAIL_FROM=                       # 例如 Motif <hello@motifne.net>
# 积分单价，默认值见 src/lib/credits/pricing.ts
# MOTIF_CREDITS_SIGNUP_BONUS=200
# MOTIF_CREDITS_UNLOCK_ITEM=10
# MOTIF_CREDITS_UNLOCK_SKILL=10
# MOTIF_CREDITS_PER_1K_INPUT=1
# MOTIF_CREDITS_PER_1K_OUTPUT=5
# MOTIF_CREDITS_STUDIO_MINIMUM=20
# MOTIF_CREDITS_CUSTOM_ORDER=300

# 社区链（见 docs/deploy-community.md）。不设 MOTIF_CHAIN_RPC_URL 就关闭社区功能。
# MOTIF_CHAIN_RPC_URL=http://127.0.0.1:8545
# MOTIF_CHAIN_PUBLIC_RPC_URL=
# MOTIF_CHAIN_DEPLOYMENT=
# MOTIF_CHAIN_START_BLOCK=0
# MOTIF_CHAIN_NAME=
# 投稿源码和托管文字的存放目录（生产环境要放在持久化磁盘上）
# MOTIF_COMMUNITY_DATA=

# 工作台（Studio）的 agent。开发模式不设时默认用本机 Claude Code CLI（claude-sonnet-5-5，只在开发期用，见 docs/decisions/0003）。
# MOTIF_AGENT_PROVIDER=claude-cli        # claude-cli | anthropic | openai-compatible | scripted（e2e 用）
# MOTIF_AGENT_API_KEY=                   # anthropic / openai-compatible 的 key，只放服务端
# MOTIF_AGENT_MODEL=                     # 例如 claude-sonnet-5-5
# MOTIF_AGENT_BASE_URL=                  # openai-compatible 必填；anthropic 可选（网关）
# MOTIF_AGENT_VISION=true                # 模型能不能看图。纯文本模型（例如 deepseek-v4-pro）设为 false：agent 不再截图，只看编译和检查结果
# MOTIF_AGENT_SESSION_TOKENS=600000      # 每个会话的模型用量上限
# MOTIF_CLAUDE_CLI_PATH=                 # 默认 ~/.local/bin/claude(.exe)
# MOTIF_CLAUDE_MODEL=claude-sonnet-5-5
# agent 截图（look_at_preview）用的浏览器：msedge | chrome | chromium | off。开发模式默认用本机 Edge / Chrome，生产默认关闭
# MOTIF_CAPTURE_CHANNEL=
# 工作台会话的存放目录（默认仓库根目录下的 .data/studio）；超过保留天数没动过的会话会被清理
# MOTIF_STUDIO_DATA=
# MOTIF_STUDIO_RETENTION_DAYS=30
# 全站每天最多跑多少轮 agent（每轮都花模型额度）
# MOTIF_STUDIO_DAILY_RUNS=300

# 给 agent 的商店（docs/decisions/0008-agent-store.md）：MCP 服务 /mcp、HTTP 接口 /api/agent、/llms.txt
# 订单的存放目录（默认仓库根目录下的 .data/orders）
# MOTIF_ORDERS_DATA=
# 定制单的价格（USDC，十进制字符串）；第一阶段默认 0，付款还没开放
# MOTIF_STORE_CUSTOM_PRICE_USDC=0
# 1 USDC 折合多少 MOTIF，以及用 MOTIF 付款的折扣（0–1）
# MOTIF_STORE_MOTIF_PER_USDC=100
# MOTIF_STORE_MOTIF_DISCOUNT=0.2
# 全站每天最多接多少张免费定制单、做多少次预览截图
# MOTIF_STORE_DAILY_CUSTOM_ORDERS=40
# MOTIF_STORE_DAILY_PREVIEWS=2000
