{
  "name": "@motif/contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Motif community contracts (registry, curation, identity, token, governance) and their TypeScript bindings.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "hardhat build",
    "lint": "hardhat build --quiet && tsc --noEmit -p tsconfig.json",
    "test": "hardhat test && vitest run && tsx scripts/export-abi.ts --check",
    "abi": "hardhat build && tsx scripts/export-abi.ts",
    "node": "hardhat node",
    "deploy:local": "hardhat ignition deploy ignition/modules/motif.ts --network localhost --parameters ignition/parameters/local.json",
    "seed:local": "hardhat run scripts/seed-catalog.ts --network localhost"
  },
  "devDependencies": {
    "@motif/registry": "workspace:*",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@nomicfoundation/hardhat-verify": "^3.1.2",
    "@nomicfoundation/hardhat-viem": "^3.0.9",
    "@nomicfoundation/hardhat-viem-assertions": "^3.1.3",
    "@nomicfoundation/ignition-core": "^3.1.10",
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "^24.19.0",
    "forge-std": "github:foundry-rs/forge-std#v1.17.0",
    "hardhat": "^3.18.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@motif/schema": "workspace:*",
    "viem": "^2.57.3"
  }
}
