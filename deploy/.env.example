# 服务器上复制成 /opt/motif/.env（源码目录外面）再填写。不要提交真实的 .env。

# 站点和预览沙箱的主机名。没有域名时用服务器 IP（点换成短横线）：
SITE_HOST=203-0-113-10.sslip.io
PREVIEW_HOST=203-0-113-10.nip.io

# 账号、积分、用户仓库（docs/decisions/0009）。
# 登录会话的签名密钥，必填：openssl rand -base64 48
MOTIF_AUTH_SECRET=
# 管理员（逗号分隔的邮箱，必须是验证过的），能进 /admin 确认积分订单、加减积分。
MOTIF_ADMIN_EMAILS=
# 付款通道接入前，用户下单后把订单号发到这个邮箱。
MOTIF_SUPPORT_EMAIL=
# GitHub 登录：在 https://github.com/settings/developers 新建 OAuth App，
# 回调地址填 https://<SITE_HOST>/api/auth/callback/github。不填就不显示 GitHub 登录。
MOTIF_GITHUB_CLIENT_ID=
MOTIF_GITHUB_CLIENT_SECRET=
# （可选）匿名导入公开 GitHub 仓库时用的令牌，提高 GitHub 的限额；只需要公开仓库的只读权限。
MOTIF_GITHUB_TOKEN=
# 发邮件（验证邮箱、重置密码）。Spacemail：mail.spacemail.com，465。不填就关闭邮箱注册。
MOTIF_SMTP_HOST=
MOTIF_SMTP_PORT=465
MOTIF_SMTP_USER=
MOTIF_SMTP_PASSWORD=
MOTIF_MAIL_FROM=
# 积分单价（留空用 apps/web/src/lib/credits/pricing.ts 里的默认值）。
MOTIF_CREDITS_SIGNUP_BONUS=
MOTIF_CREDITS_UNLOCK_ITEM=
MOTIF_CREDITS_UNLOCK_SKILL=
MOTIF_CREDITS_PER_1K_INPUT=
MOTIF_CREDITS_PER_1K_OUTPUT=
MOTIF_CREDITS_STUDIO_MINIMUM=
MOTIF_CREDITS_CUSTOM_ORDER=

# 社区链（不填就关闭社区功能）。非本地链必须同时填公开 RPC，见 docs/deploy-community.md。
MOTIF_CHAIN_RPC_URL=
MOTIF_CHAIN_PUBLIC_RPC_URL=
MOTIF_CHAIN_START_BLOCK=0
MOTIF_CHAIN_NAME=

# 工作台（Studio）的 agent：anthropic 或 openai-compatible（后者要填 BASE_URL）。不填就关闭 agent。
# 用的是站点自己的 key，每个会话最多消耗 MOTIF_AGENT_SESSION_TOKENS 个 token（默认 600000）。
MOTIF_AGENT_PROVIDER=
MOTIF_AGENT_API_KEY=
MOTIF_AGENT_MODEL=
MOTIF_AGENT_BASE_URL=
MOTIF_AGENT_SESSION_TOKENS=
