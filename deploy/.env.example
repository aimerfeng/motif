# 服务器上复制成 /opt/motif/.env（源码目录外面）再填写。不要提交真实的 .env。

# 站点和预览沙箱的主机名。没有域名时用服务器 IP（点换成短横线）：
SITE_HOST=203-0-113-10.sslip.io
PREVIEW_HOST=203-0-113-10.nip.io

# 社区链（不填就关闭社区功能）。非本地链必须同时填公开 RPC，见 docs/deploy-community.md。
MOTIF_CHAIN_RPC_URL=
MOTIF_CHAIN_PUBLIC_RPC_URL=
MOTIF_CHAIN_START_BLOCK=0
MOTIF_CHAIN_NAME=
